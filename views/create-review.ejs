<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Review - IMO</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card">
          <div class="card-header">
            <h3><%= __('create_review.title') %></h3>
          </div>
          <div class="card-body">
            <form id="review-form" enctype="multipart/form-data">
              <div class="mb-3">
                <label for="title" class="form-label"><%= __('create_review.review_title') %></label>
                <input type="text" class="form-control" id="title" name="title" required>
              </div>
              <div class="mb-3">
                <label for="productName" class="form-label"><%= __('create_review.product_name') %></label>
                <input type="text" class="form-control" id="productName" name="productName" required>
              </div>
              <div class="row mb-3">
                <div class="col-md-6">
                  <label for="category" class="form-label"><%= __('create_review.category') %></label>
                  <select class="form-select" id="category" name="category" required>
                    <option value="" selected disabled><%= __('create_review.select_category') %></option>
                    <!-- <% if (categories && categories.length > 0) { %>
                      <% categories.forEach(category => { %>
                        <option value="<%= category %>"><%= category %></option>
                      <% }) %>
                    <% } %> -->
                    <option value="Electronics"><%= __('category.electronics') %></option>
                    <option value="Home Appliances"><%= __('category.home_appliances') %></option>
                    <option value="Kitchen Appliances"><%= __('category.kitchen_appliances') %></option>
                    <option value="Restaurants"><%= __('category.restaurants') %></option>
                    <option value="Hotels"><%= __('category.hotels') %></option>
                    <option value="Entertainment"><%= __('category.entertainment') %></option>
                    <option value="Movies"><%= __('category.movies') %></option>
                    <option value="Series"><%= __('category.series') %></option>
                    <option value="Books"><%= __('category.books') %></option>
                    <option value="Fitness"><%= __('category.fitness') %></option>
                    <option value="Footwear"><%= __('category.footwear') %></option>
                    <option value="Other"><%= __('category.other') %></option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="rating" class="form-label"><%= __('create_review.rating') %></label>
                  <select class="form-select" id="rating" name="rating" required>
                    <option value="" selected disabled><%= __('create_review.select_rating') %></option>
                    <option value="5"><%= __('create_review.5_excellent') %></option>
                    <option value="4"><%= __('create_review.4_good') %></option>
                    <option value="3"><%= __('create_review.3_average') %></option>
                    <option value="2"><%= __('create_review.2_poor') %></option>
                    <option value="1"><%= __('create_review.1_terrible') %></option>
                  </select>
                </div>
              </div>
              <div class="mb-3">
                <label for="content" class="form-label"><%= __('create_review.content') %></label>
                <textarea class="form-control" id="content" name="content" rows="6" required></textarea>
              </div>
              <div class="mb-3">
                <label for="language" class="form-label"><%= __('create_review.language') %></label>
                <select class="form-select" id="language" name="language">
                  <option value="" selected><%= __('create_review.select_language') %></option>
                  <option value="Uzbek"><%= __('search.uzbek') %></option>
                  <option value="English"><%= __('search.english') %></option>
                  <option value="Russian"><%= __('search.russian') %></option>
                  <option value="Kazakh"><%= __('search.kazakh') %></option>
                  <option value="Tadjik"><%= __('search.tadjik') %></option>
                  <option value="Turkish"><%= __('search.turkish') %></option>
                </select>
              </div>
              <div class="mb-3">
                <label for="images" class="form-label"><%= __('create_review.attach_images') %></label>
                <input type="file" class="form-control" id="images" name="images" accept="image/*" multiple max="3">
                <div id="image-preview" class="d-flex mt-2 gap-2"></div>
              </div>
              <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a href="/" class="btn btn-secondary me-md-2"><%= __('create_review.cancel') %></a>
                <button type="submit" class="btn btn-primary"><%= __('create_review.submit') %></button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Preview selected images as squares
    document.getElementById('images').addEventListener('change', function(e) {
      const preview = document.getElementById('image-preview');
      preview.innerHTML = '';
      const files = Array.from(e.target.files).slice(0, 3);
      files.forEach(file => {
        const reader = new FileReader();
        reader.onload = function(ev) {
          const img = document.createElement('img');
          img.src = ev.target.result;
          img.style.width = '80px';
          img.style.height = '80px';
          img.style.objectFit = 'cover';
          img.style.borderRadius = '8px';
          img.style.border = '1px solid #ccc';
          preview.appendChild(img);
        }
        reader.readAsDataURL(file);
      });
    });

    document.getElementById('review-form').addEventListener('submit', function(e) {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);
      // Only allow up to 3 images
      const files = document.getElementById('images').files;
      if (files.length > 3) {
        alert('You can only upload up to 3 images.');
        return;
      }
      // Append other fields manually if not present
      formData.set('title', document.getElementById('title').value);
      formData.set('productName', document.getElementById('productName').value);
      formData.set('category', document.getElementById('category').value);
      formData.set('rating', document.getElementById('rating').value);
      formData.set('content', document.getElementById('content').value);
      fetch('/api/reviews', {
        method: 'POST',
        body: formData,
      })
      .then(response => response.json())
      .then(review => {
        window.location.href = `/reviews/${review.id}`;
      })
      .catch(error => {
        console.error('Error:', error);
        alert('There was an error creating your review. Please try again.');
      });
    });
  </script>
</body>
</html>
