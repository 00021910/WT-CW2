<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Search Results - IMO</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container mt-3">
    <button class="btn btn-outline-secondary mb-3" onclick="window.history.length > 1 ? window.history.back() : window.location.href='/'">← Back</button>
  </div>

  <div class="container mt-5">
    <h1 class="mb-4"><%= __('search.title') %></h1>
    
    <div class="row mb-4">
      <div class="col-12">
        <form action="/search" method="GET" class="card p-3">
          <div class="row g-3">
            <div class="col-md-6">
              <input type="text" name="q" class="form-control" placeholder="<%= __('home.search_placeholder') %>" value="<%= query.q || '' %>">
            </div>
            <div class="col-md-2 d-flex align-items-center">
              <!-- Filter Modal Button -->
              <button type="button" class="btn btn-outline-secondary w-100" data-bs-toggle="modal" data-bs-target="#filterModal">
                <i class="bi bi-funnel"></i> <%= __('home.search') %> Filter
              </button>
            </div>
            <div class="col-md-2">
              <button type="submit" class="btn btn-primary w-100"><%= __('home.search') %></button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Filter Modal -->
    <div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="filterModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <form action="/search" method="GET">
            <div class="modal-header">
              <h5 class="modal-title" id="filterModalLabel"><%= __('home.search') %> Filter</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label"><%= __('search.all_categories') %></label>
                <select name="category" class="form-select">
                  <option value=""><%= __('search.all_categories') %></option>
                  <% if (categories && categories.length > 0) { %>
                    <% categories.forEach(category => { %>
                      <option value="<%= category.key %>" <%= query.category === category.key ? 'selected' : '' %>><%= category.name %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label"><%= __('search.all_ratings') %></label>
                <select name="rating" class="form-select">
                  <option value=""><%= __('search.all_ratings') %></option>
                  <option value="5" <%= query.rating === '5' ? 'selected' : '' %>><%= __('search.5_stars') %></option>
                  <option value="4" <%= query.rating === '4' ? 'selected' : '' %>><%= __('search.4_stars') %></option>
                  <option value="3" <%= query.rating === '3' ? 'selected' : '' %>><%= __('search.3_stars') %></option>
                  <option value="2" <%= query.rating === '2' ? 'selected' : '' %>><%= __('search.2_stars') %></option>
                  <option value="1" <%= query.rating === '1' ? 'selected' : '' %>><%= __('search.1_star') %></option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label"><%= __('search.all_sentiments') %></label>
                <select name="sentiment" class="form-select">
                  <option value=""><%= __('search.all_sentiments') %></option>
                  <option value="positive" <%= query.sentiment === 'positive' ? 'selected' : '' %>><%= __('search.positive') %></option>
                  <option value="neutral" <%= query.sentiment === 'neutral' ? 'selected' : '' %>><%= __('search.neutral') %></option>
                  <option value="negative" <%= query.sentiment === 'negative' ? 'selected' : '' %>><%= __('search.negative') %></option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label"><%= __('search.all_languages') %></label>
                <select name="language" class="form-select">
                  <option value=""><%= __('search.all_languages') %></option>
                  <option value="Uzbek" <%= query.language === 'Uzbek' ? 'selected' : '' %>><%= __('search.uzbek') %></option>
                  <option value="English" <%= query.language === 'English' ? 'selected' : '' %>><%= __('search.english') %></option>
                  <option value="Russian" <%= query.language === 'Russian' ? 'selected' : '' %>><%= __('search.russian') %></option>
                  <option value="Kazakh" <%= query.language === 'Kazakh' ? 'selected' : '' %>><%= __('search.kazakh') %></option>
                  <option value="Tadjik" <%= query.language === 'Tadjik' ? 'selected' : '' %>><%= __('search.tadjik') %></option>
                  <option value="Turkish" <%= query.language === 'Turkish' ? 'selected' : '' %>><%= __('search.turkish') %></option>
                </select>
              </div>
            </div>
            <div class="modal-footer">
              <a href="/search" class="btn btn-outline-secondary"><%= __('search.clear_filters') %></a>
              <button type="submit" class="btn btn-primary"><%= __('home.search') %></button>
            </div>
          </form>
        </div>
      </div>
    </div>
    
    <div class="row">
      <% if (reviews && reviews.length > 0) { %>
        <% reviews.forEach(review => { %>
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
              <% if (review.images && review.images.length > 0) { %>
                <img src="<%= review.images[0] %>" class="card-img-top" alt="<%= review.title %>" style="height: 200px; object-fit: cover;">
              <% } %>
              <div class="card-body">
                <h5 class="card-title"><%= review.title %></h5>
                <h6 class="card-subtitle mb-2 text-muted"><%= review.productName %> - <%= review.category %></h6>
                <div class="mb-2">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <% if (i <= review.rating) { %>
                      <span class="text-warning">★</span>
                    <% } else { %>
                      <span class="text-secondary">★</span>
                    <% } %>
                  <% } %>
                </div>
                <p class="card-text"><%= review.content.substring(0, 150) %>...</p>
                <div class="d-flex justify-content-between align-items-center">
                  <small class="text-muted">By <%= review.username %></small>
                  <a href="/reviews/<%= review.id %>" class="btn btn-sm btn-outline-primary">Read More</a>
                </div>
              </div>
              <div class="card-footer text-muted">
                <small><%= new Date(review.createdAt).toLocaleDateString() %></small>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <div class="alert alert-info">
            <%= __('search.no_results') %>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
