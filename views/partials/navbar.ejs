<nav class="navbar navbar-expand-lg">
  <div class="container">
    <a class="navbar-brand" href="/">IMO</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link" href="/"><%= __('navbar.home') %></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/search"><%= __('navbar.search') %></a>
        </li>
        <!-- Category Dropdown -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <%= __('search.all_categories') %>
          </a>
          <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
            <li><a class="dropdown-item" href="/category/electronics"><%= __('category.electronics') %></a></li>
            <li><a class="dropdown-item" href="/category/home_appliances"><%= __('category.home_appliances') %></a></li>
            <li><a class="dropdown-item" href="/category/kitchen_appliances"><%= __('category.kitchen_appliances') %></a></li>
            <li><a class="dropdown-item" href="/category/restaurants"><%= __('category.restaurants') %></a></li>
            <li><a class="dropdown-item" href="/category/hotels"><%= __('category.hotels') %></a></li>
            <li><a class="dropdown-item" href="/category/entertainment"><%= __('category.entertainment') %></a></li>
            <li><a class="dropdown-item" href="/category/movies"><%= __('category.movies') %></a></li>
            <li><a class="dropdown-item" href="/category/series"><%= __('category.series') %></a></li>
            <li><a class="dropdown-item" href="/category/books"><%= __('category.books') %></a></li>
            <li><a class="dropdown-item" href="/category/fitness"><%= __('category.fitness') %></a></li>
            <li><a class="dropdown-item" href="/category/footwear"><%= __('category.footwear') %></a></li>
            <li><a class="dropdown-item" href="/category/other"><%= __('category.other') %></a></li>
          </ul>
        </li>
      </ul>
      <ul class="navbar-nav">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <%= __('navbar.profile_dashboard') %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <li><a class="dropdown-item" href="/profile"><%= __('navbar.my_profile') %></a></li>
              <% if (typeof user !== 'undefined' && user && user.role === 'Admin') { %>
                <li><a class="dropdown-item" href="/admin"><%= __('navbar.admin_page') %></a></li>
              <% } %>
            </ul>
          </li>
          <li class="nav-item dropdown ms-2">
            <a class="nav-link dropdown-toggle" href="#" id="langDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <% if (locale === 'uz') { %><%= __('navbar.language.uz') %><% } else if (locale === 'ru') { %><%= __('navbar.language.ru') %><% } else { %><%= __('navbar.language.en') %><% } %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="langDropdown">
              <li><a class="dropdown-item" href="#" onclick="setLocale('uz')"><%= __('navbar.language.uz') %></a></li>
              <li><a class="dropdown-item" href="#" onclick="setLocale('ru')"><%= __('navbar.language.ru') %></a></li>
              <li><a class="dropdown-item" href="#" onclick="setLocale('en')"><%= __('navbar.language.en') %></a></li>
            </ul>
          </li>
      </ul>
    </div>
  </div>
</nav>
<script>
  function setLocale(locale) {
    document.cookie = 'imo-locale=' + locale + ';path=/';
    window.location.reload();
  }
  
  // Navbar scroll effect
  window.addEventListener('scroll', function() {
    const navbar = document.querySelector('.navbar');
    if (window.scrollY > 50) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  });
</script>
