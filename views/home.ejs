<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IMO - Review Platform</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <div class="row mb-4">
      <div class="col-md-8">
        <h1><%= __('home.welcome') %></h1>
        <p class="lead"><%= __('home.lead') %></p>
      </div>
      <div class="col-md-4 text-end">
        <% if (user) { %>
          <a href="/create-review" class="btn btn-primary"><%= __('home.leave_review') %></a>
        <% } else { %>
          <a href="/login" class="btn btn-outline-primary me-2"><%= __('home.login') %></a>
          <a href="/signup" class="btn btn-primary"><%= __('home.signup') %></a>
        <% } %>
      </div>
    </div>

    <div class="row mb-4">
      <div class="col-12">
        <form action="/search" method="GET" class="d-flex">
          <input type="text" name="q" class="form-control me-2" placeholder="<%= __('home.search_placeholder') %>">
          <button type="submit" class="btn btn-primary"><%= __('home.search') %></button>
        </form>
      </div>
    </div>

    <h2 class="mb-4"><%= __('home.popular_reviews') %></h2>
    
    <div class="row">
      <% if (popularReviews && popularReviews.length > 0) { %>
        <% popularReviews.forEach(review => { %>
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="card-title"><%= review.title %></h5>
                <h6 class="card-subtitle mb-2 text-muted"><%= review.productName %></h6>
                <div class="mb-2">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <% if (i <= review.rating) { %>
                      <span class="text-warning">★</span>
                    <% } else { %>
                      <span class="text-secondary">★</span>
                    <% } %>
                  <% } %>
                </div>
                <p class="card-text"><%= review.content.substring(0, 150) %>...</p>
                <div class="d-flex justify-content-between align-items-center">
                  <small class="text-muted">By <%= review.username %></small>
                  <a href="/reviews/<%= review.id %>" class="btn btn-sm btn-outline-primary"><%= __('home.read_more') %></a>
                </div>
              </div>
              <div class="card-footer text-muted">
                <small><%= new Date(review.createdAt).toLocaleDateString() %></small>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <p><%= __('home.no_reviews') %></p>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
