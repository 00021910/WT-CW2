<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Review - IMO</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card">
          <div class="card-header">
            <h3><%= __('edit_review.title') %></h3>
          </div>
          <div class="card-body">
            <form id="edit-review-form">
              <div class="mb-3">
                <label for="title" class="form-label"><%= __('create_review.review_title') %></label>
                <input type="text" class="form-control" id="title" name="title" value="<%= review.title %>" required>
              </div>
              <div class="mb-3">
                <label for="productName" class="form-label"><%= __('create_review.product_name') %></label>
                <input type="text" class="form-control" id="productName" name="productName" value="<%= review.productName %>" required>
              </div>
              <div class="row mb-3">
                <div class="col-md-6">
                  <label for="category" class="form-label"><%= __('create_review.category') %></label>
                  <select class="form-select" id="category" name="category" required>
                    <% if (categories && categories.length > 0) { %>
                      <% categories.forEach(category => { %>
                        <option value="<%= category %>" <%= review.category === category ? 'selected' : '' %>><%= category %></option>
                      <% }) %>
                    <% } %>
                    <option value="Electronics" <%= review.category === 'Electronics' ? 'selected' : '' %>>Electronics</option>
                    <option value="Home Appliances" <%= review.category === 'Home Appliances' ? 'selected' : '' %>>Home Appliances</option>
                    <option value="Kitchen Appliances" <%= review.category === 'Kitchen Appliances' ? 'selected' : '' %>>Kitchen Appliances</option>
                    <option value="Restaurants" <%= review.category === 'Restaurants' ? 'selected' : '' %>>Restaurants</option>
                    <option value="Hotels" <%= review.category === 'Hotels' ? 'selected' : '' %>>Hotels</option>
                    <option value="Entertainment" <%= review.category === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
                    <option value="Movies" <%= review.category === 'Movies' ? 'selected' : '' %>>Movies</option>
                    <option value="Series" <%= review.category === 'Series' ? 'selected' : '' %>>Series</option>
                    <option value="Books" <%= review.category === 'Books' ? 'selected' : '' %>>Books</option>
                    <option value="Fitness" <%= review.category === 'Fitness' ? 'selected' : '' %>>Fitness</option>
                    <option value="Footwear" <%= review.category === 'Footwear' ? 'selected' : '' %>>Footwear</option>
                    <option value="Other" <%= review.category === 'Other' ? 'selected' : '' %>>Other</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="rating" class="form-label"><%= __('create_review.rating') %></label>
                  <select class="form-select" id="rating" name="rating" required>
                    <option value="5" <%= review.rating === 5 ? 'selected' : '' %>><%= __('create_review.5_excellent') %></option>
                    <option value="4" <%= review.rating === 4 ? 'selected' : '' %>><%= __('create_review.4_good') %></option>
                    <option value="3" <%= review.rating === 3 ? 'selected' : '' %>><%= __('create_review.3_average') %></option>
                    <option value="2" <%= review.rating === 2 ? 'selected' : '' %>><%= __('create_review.2_poor') %></option>
                    <option value="1" <%= review.rating === 1 ? 'selected' : '' %>><%= __('create_review.1_terrible') %></option>
                  </select>
                </div>
              </div>
              <div class="mb-3">
                <label for="content" class="form-label"><%= __('create_review.content') %></label>
                <textarea class="form-control" id="content" name="content" rows="6" required><%= review.content %></textarea>
              </div>
              <div class="mb-3">
                <label for="language" class="form-label"><%= __('create_review.language') %></label>
                <select class="form-select" id="language" name="language">
                  <option value="" <%= !review.language ? 'selected' : '' %>><%= __('create_review.select_language') %></option>
                  <option value="English" <%= review.language === 'English' ? 'selected' : '' %>>English</option>
                  <option value="Uzbek" <%= review.language === 'Uzbek' ? 'selected' : '' %>>Uzbek</option>
                  <option value="Russian" <%= review.language === 'Russian' ? 'selected' : '' %>>Russian</option>
                  <option value="Spanish" <%= review.language === 'Spanish' ? 'selected' : '' %>>Spanish</option>
                  <option value="French" <%= review.language === 'French' ? 'selected' : '' %>>French</option>
                  <option value="German" <%= review.language === 'German' ? 'selected' : '' %>>German</option>
                  <option value="Chinese" <%= review.language === 'Chinese' ? 'selected' : '' %>>Chinese</option>
                  <option value="Japanese" <%= review.language === 'Japanese' ? 'selected' : '' %>>Japanese</option>
                  <option value="Other" <%= review.language === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
              </div>
              <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a href="/reviews/<%= review.id %>" class="btn btn-secondary me-md-2"><%= __('edit_review.cancel') %></a>
                <button type="submit" class="btn btn-primary"><%= __('edit_review.update') %></button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.getElementById('edit-review-form').addEventListener('submit', function(e) {
      e.preventDefault();
      
      const formData = {
        title: document.getElementById('title').value,
        productName: document.getElementById('productName').value,
        category: document.getElementById('category').value,
        rating: document.getElementById('rating').value,
        content: document.getElementById('content').value
      };
      
      fetch('/api/reviews/<%= review.id %>', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(formData),
      })
      .then(response => response.json())
      .then(review => {
        window.location.href = `/reviews/${review.id}`;
      })
      .catch(error => {
        console.error('Error:', error);
        alert('There was an error updating your review. Please try again.');
      });
    });
  </script>
</body>
</html>
